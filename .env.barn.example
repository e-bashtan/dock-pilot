# Copy to .env on VPS:  cp .env.barn.example .env && chmod 600 .env
# PostgreSQL runs in Docker (image barn-postgres:latest from the release bundle).

POSTGRES_USER=barn
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=barn
POSTGRES_IMAGE=barn-postgres:latest

DATABASE_URL=postgres://barn:change-me-strong-postgres-password@postgres:5432/barn?sslmode=disable
# API uses host network and connects via POSTGRES_HOST_PORT (migrate container still uses DATABASE_URL above).
POSTGRES_HOST_PORT=5433

HTTP_ADDR=:8080
SECRETS_ENCRYPTION_KEY=change-me-to-32-byte-key-here!!
API_TOKEN=change-me-long-api-token-here

PANEL_DOMAIN=deploy.example.com
# Leave PANEL_DOMAIN empty for http://SERVER_IP:PANEL_HTTP_PORT (no TLS for the panel).
# PANEL_DOMAIN=
PANEL_HTTP_PORT=8888
CORS_ALLOWED_ORIGINS=https://deploy.example.com

DEPLOY_MODE=real
DEPLOY_WORK_DIR=/var/lib/barn
HOST_ROOT=/host
NGINX_SITES_AVAILABLE=/host/etc/nginx/sites-available
NGINX_SITES_ENABLED=/host/etc/nginx/sites-enabled
CERTBOT_EMAIL=admin@example.com
# Required before SSL for deployed sites or panel domain. Can stay empty for IP-only panel access.

# Optional: outbound proxy if api.telegram.org is blocked on the VPS (Russia, etc.)
# API runs with host network — use the same SOCKS as your bots, e.g. socks5://127.0.0.1:1080
# TELEGRAM_HTTP_PROXY=socks5://127.0.0.1:1080

API_PORT=8080
FRONTEND_PORT=3000

API_IMAGE=barn-api:latest
FRONTEND_IMAGE=barn-frontend:latest
MIGRATE_IMAGE=barn-migrate:latest
